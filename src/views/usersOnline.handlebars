<h2>Usuarios en línea</h2>

<section class="d-flex flex-wrap justify-content-evenly">
  <ul class="list-group list-group-numbered">
    {{#each data}}
      <li
        class="list-group-item d-flex justify-content-between align-items-start mb-1"
      >
        <div class="ms-2 me-auto">
          <div class="fw-bold">{{name}}</div>
          <div>{{#if (eq role "admin")}} Admin {{else}} User {{/if}}</div>
          <small>{{_id}}</small>
        </div>

        {{#if (eq isOnline true)}}
          <span class="badge text-bg-success rounded-pill">*</span><span
            class="ms-1"
          > En Línea</span>
        {{else}}
          <span class="badge text-bg-danger rounded-pill">*</span><span
            class="ms-1"
          >Desconectado</span>
        {{/if}}

        <!-- Enlace para eliminar usuario -->
        <a href="#" class="delete-user ms-3" data-id="{{_id}}">Eliminar</a>
      </li>
    {{/each}}
  </ul>
</section>